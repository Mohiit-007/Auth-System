# Backend environment example for focusSync
# Copy this file to `.env` and fill the values before running the server.

# Server
PORT=8000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://localhost:27017/your-database-name

# JWT secrets
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here
JWT_SECRET=your_token_secret_here

# Email (OAuth2 - used by services/email.js)
EMAIL_USER=your-email@example.com
CLIENT_ID=your_google_oauth_client_id
CLIENT_SECRET=your_google_oauth_client_secret
REFRESH_TOKEN=your_google_oauth_refresh_token
REDIRECT_URI=your_google_oauth_redirect_uri

# Cloudinary (if used)
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Optional: other third-party keys
# Example: SENTRY_DSN=your_sentry_dsn

